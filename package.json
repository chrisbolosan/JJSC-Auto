{
  "name": "root jjsc-auto",
  "version": "1.0.0",
  "description": "root package sync with api and web package",
  "scripts": {
    "setup": "npm install && npm install --prefix web",
    "dev:api": "npm run dev --prefix api",
    "dev:web": "npm run dev --prefix web",
    "dev": "npm run dev --prefix web",
    "generate:types": "supabase gen types typescript --linked --schema public > shared/src/database.types.ts",
    "seed": "npx supabase --yes db push --linked --include-seed",
    "typecheck": "npm run typechecker --prefix web"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "kill-port": "^2.0.1",
    "supabase": "^2.122.0"
  }
}
